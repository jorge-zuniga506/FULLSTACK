# ─── Base de Datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecosistema_startups
PORT=3007

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Opcional. Por defecto: 'super_secret_jwt_key_123'
JWT_SECRET=mi_clave_secreta_jwt

# ─── Cloudinary (para subida de logos) ───────────────────────────────────────
# Si se omiten, los logos se guardan localmente en backend/uploads/
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ─── SMTP / Email (para notificaciones de solicitudes) ────────────────────────
# Si se omiten, no se envían correos (no falla)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
